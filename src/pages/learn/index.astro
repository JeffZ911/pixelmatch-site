---
import { getCollection } from "astro:content";
import ArticleListing from "../../components/ArticleListing.astro";

const entries = await getCollection("learn");
---

<ArticleListing
  collectionLabel="How-To Guides"
  collectionSlug="learn"
  intro="Step-by-step playbooks for product photography, image editing, and listing assets across Amazon, Shopify, Etsy, and TikTok Shop."
  entries={entries}
/>
