---
import { getCollection } from "astro:content";
import ArticleListing from "../../components/ArticleListing.astro";

const entries = await getCollection("stories");
---

<ArticleListing
  collectionLabel="Seller Case Studies"
  collectionSlug="stories"
  intro="Real and composite seller workflows — how Amazon FBA owners, Shopify dropshippers, Etsy POD shops, and TikTok Shop creators scale photo production with AI. Numbers cited, sources linked, honest limitations called out."
  entries={entries}
/>
