---
import { getCollection } from "astro:content";
import ArticleListing from "../../components/ArticleListing.astro";

const entries = await getCollection("compare");
---

<ArticleListing
  collectionLabel="Tool Comparisons"
  collectionSlug="compare"
  intro="Honest, hands-on comparisons of AI image tools for sellers — PixelMatch vs Photoroom, Canva, Pebblely, Photoroom, and more. Tested across real Amazon, Shopify, and Etsy workflows."
  entries={entries}
/>
