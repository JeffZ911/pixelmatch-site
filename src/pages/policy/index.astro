---
import { getCollection } from "astro:content";
import ArticleListing from "../../components/ArticleListing.astro";

const entries = await getCollection("policy");
---

<ArticleListing
  collectionLabel="Platform Image Policies"
  collectionSlug="policy"
  intro="Current image and listing requirements across Amazon, Shopify, Etsy, and TikTok Shop. Pixel dimensions, common rejection reasons, and exactly how to fix each one."
  entries={entries}
/>
