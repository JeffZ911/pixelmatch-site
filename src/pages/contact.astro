---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact — PixelMatch Blog"
  description="Report a factual error, request a takedown, or share editorial feedback for the PixelMatch blog."
>
  <h1 class="text-ink">Contact the editor</h1>

  <div class="prose-pm max-w-prose">
    <p>
      Found a factual error, have feedback, or need to request a
      takedown? Reach the editorial team directly through the channels
      below.
    </p>

    <h2>Editorial corrections &amp; feedback</h2>
    <p>
      Email <a href="mailto:editor@pixelmatch.art">editor@pixelmatch.art</a>
      with the URL of the page in question and a clear description of
      the issue. Articles are AI-assisted, so factual corrections are
      welcomed and reviewed quickly.
    </p>

    <h2>Product support</h2>
    <p>
      Questions about the PixelMatch tool itself, billing, or your
      account belong with the product team:
      <a href="https://pixelmatch.art/contact">pixelmatch.art/contact</a>.
    </p>

    <h2>DMCA / takedown</h2>
    <p>
      For copyright takedown requests, email
      <a href="mailto:legal@pixelmatch.art">legal@pixelmatch.art</a>
      with: (1) the URL of the page in question, (2) the original work
      claimed, and (3) your contact details. We review within 7 business
      days.
    </p>
  </div>
</BaseLayout>
