---
// Blog header. Mirrors the live SaaS landing (pixelmatch.art):
//   • White background, ink-dark text
//   • Small violet brand mark on the left
//   • Plain nav links + a violet "Try PixelMatch" CTA on the right
//
// Nav points back to the SaaS for product surfaces (/, /pricing, /how-it-
// works), and stays inside the blog (/blog/...) for content surfaces.

const blogBase = (import.meta.env.BASE_URL || "/blog").replace(/\/$/, "");
const SAAS = "https://pixelmatch.art";

const nav = [
  { href: `${blogBase}/`,         label: "Blog", internal: true },
  { href: `${blogBase}/learn/`,   label: "Guides", internal: true },
  { href: `${blogBase}/compare/`, label: "Compare", internal: true },
  { href: `${blogBase}/stories/`, label: "Case Studies", internal: true },
  { href: `${SAAS}/#pricing`,     label: "Pricing", internal: false },
];

const ctaHref =
  `${SAAS}/signup?utm_source=blog&utm_medium=header&utm_campaign=nav_cta`;
---

<header class="sticky top-0 z-30 border-b border-body-line bg-white/95 backdrop-blur">
  <div class="container-page flex h-14 items-center justify-between">
    <a
      href={`${blogBase}/`}
      class="flex items-center gap-2 no-underline text-ink"
    >
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-primary-500 text-white text-sm font-bold shadow-glow-primary">
        P
      </span>
      <span class="font-display text-lg font-semibold tracking-tight">
        PixelMatch
        <span class="text-body-faint font-normal">· Blog</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-1 text-sm">
      {nav.map((n) => (
        <a
          href={n.href}
          class="rounded-md px-3 py-2 text-body-muted no-underline hover:bg-primary-50 hover:text-ink"
        >
          {n.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={`${SAAS}/login`}
        class="hidden sm:inline-block rounded-md px-3 py-1.5 text-sm text-body-muted no-underline hover:text-ink"
      >
        Log in
      </a>
      <a
        href={ctaHref}
        class="inline-block rounded-md bg-primary-500 px-4 py-1.5 text-sm font-medium text-white no-underline shadow-glow-primary hover:bg-primary-600"
      >
        Try PixelMatch →
      </a>
    </div>
  </div>
</header>
